<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="720.0"
            prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.InicioController"
            style="-fx-background-color: #ECE3DB;">

    <children>

        <VBox alignment="CENTER"
              spacing="40.0"
              AnchorPane.topAnchor="30.0"
              AnchorPane.bottomAnchor="30.0"
              AnchorPane.leftAnchor="30.0"
              AnchorPane.rightAnchor="30.0">

            <!-- TITULO -->

            <HBox alignment="CENTER"
                  spacing="10.0">

                <Label text="Damas Turcas"
                       textFill="#6B4423">
                    <font>
                        <Font size="48.0" />
                    </font>
                </Label>

                <!-- FICHA OSCURA -->

                <ImageView fitHeight="45.0"
                           fitWidth="45.0"
                           preserveRatio="true">
                    <image>
                        <Image url="@../Images/ficha%20oscura.jpg"/>
                    </image>
                </ImageView>

                <!-- FICHA CLARA -->

                <ImageView fitHeight="45.0"
                           fitWidth="45.0"
                           preserveRatio="true">
                    <image>
                        <Image url="@../Images/ficha%20clara.jpg"/>
                    </image>
                </ImageView>

            </HBox>

            <!-- PANEL SCORES -->

            <VBox alignment="TOP_CENTER"
                  spacing="20.0"
                  prefWidth="450.0"
                  prefHeight="260.0"
                  style="-fx-background-color: #F6F0EA;
                         -fx-background-radius: 20;
                         -fx-border-radius: 20;
                         -fx-border-color: #D2B89F;
                         -fx-padding: 20;">

                <!-- TITULO SCORE -->

                <Label text="Scores más altos"
                       textFill="#7A4E28">
                    <font>
                        <Font size="34.0"/>
                    </font>
                </Label>

                <!-- LISTA SCORES -->

                <VBox fx:id="scoresContainer"
                      spacing="18.0"
                      alignment="CENTER_LEFT">

                    <!-- SCORE 1 -->

                    <HBox spacing="120.0"
                          alignment="CENTER_LEFT">

                        <Label text="1. Alejandro"
                               textFill="#7A4E28">
                            <font>
                                <Font size="26.0"/>
                            </font>
                        </Label>

                        <Label text="200"
                               textFill="#7A4E28">
                            <font>
                                <Font size="26.0"/>
                            </font>
                        </Label>

                    </HBox>

                    <!-- SCORE 2 -->

                    <HBox spacing="170.0"
                          alignment="CENTER_LEFT">

                        <Label text="2. Isabel"
                               textFill="#7A4E28">
                            <font>
                                <Font size="26.0"/>
                            </font>
                        </Label>

                        <Label text="150"
                               textFill="#7A4E28">
                            <font>
                                <Font size="26.0"/>
                            </font>
                        </Label>

                    </HBox>

                    <!-- SCORE 3 -->

                    <HBox spacing="140.0"
                          alignment="CENTER_LEFT">

                        <Label text="3. Marcos"
                               textFill="#7A4E28">
                            <font>
                                <Font size="26.0"/>
                            </font>
                        </Label>

                        <Label text="100"
                               textFill="#7A4E28">
                            <font>
                                <Font size="26.0"/>
                            </font>
                        </Label>

                    </HBox>

                </VBox>

            </VBox>

            <!-- BOTONES -->

            <HBox alignment="CENTER"
                  spacing="40.0">

                <!-- BOTON INICIAR -->

                <Button text="Iniciar"
                        onAction="#iniciarPartida"
                        prefWidth="250.0"
                        prefHeight="75.0"
                        style="-fx-background-color: #F6F0EA;
                               -fx-background-radius: 25;
                               -fx-border-radius: 25;
                               -fx-border-color: #D2B89F;
                               -fx-font-size: 30;
                               -fx-font-weight: bold;
                               -fx-text-fill: #7A4E28;" />

                <!-- BOTON SALIR -->

                <Button text="Salir"
                        onAction="#salir"
                        prefWidth="250.0"
                        prefHeight="75.0"
                        style="-fx-background-color: #F6F0EA;
                               -fx-background-radius: 25;
                               -fx-border-radius: 25;
                               -fx-border-color: #D2B89F;
                               -fx-font-size: 30;
                               -fx-font-weight: bold;
                               -fx-text-fill: #7A4E28;" />

            </HBox>

        </VBox>

    </children>

</AnchorPane>
